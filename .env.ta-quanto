# Build of the app published as "Tá Quanto" at /calculacarrinho/ta-quanto/
# npm run build:ta-quanto
NODE_ENV=production
VUE_APP_TITLE="Tá Quanto"
VUE_APP_DESCRIPTION="Some o preço das compras enquanto passeia pelo mercado e evite surpresas no caixa."
VUE_APP_PUBLIC_PATH="/calculacarrinho/ta-quanto/"
VUE_APP_BRAND_IMG="img/ta-quanto"
VUE_APP_SPLASH_EXT="jpg"
VUE_APP_MANIFEST="manifest-ta-quanto.json"
